# Everything is optional: with a current `oc login`, `build` needs no configuration.
# Copy to .env to set overrides. Variables set in your shell take precedence over this file.
# Values are read literally: no quotes needed, no shell expansion.

# Refuse to run unless the current context points at this cluster API URL
#OPENSHIFT_API_URL=https://api.<cluster-domain>:443

# Use this kube context instead of the current one
#KUBE_CONTEXT=<context>

# Namespace of the deployment (default: mlflow)
#NAMESPACE=mlflow

# Branch/repo to build. Normally stored on the cluster by `deploy`; setting these here
# overrides that for your builds only.
#MLFLOW_BRANCH=<branch-name>
#MLFLOW_GIT_REPO=https://github.com/mlflow/mlflow.git

# External host of the image registry route (default: discovered from the cluster)
#OPENSHIFT_REGISTRY=default-route-openshift-image-registry.apps.<cluster-domain>

# podman (default) or docker
#CONTAINER_ENGINE=podman
