# Copy to .env and fill in. Variables set in your shell take precedence over this file.
# Values are read literally: no quotes needed, no shell expansion.

# Required: the cluster's API URL (what `oc whoami --show-server` prints)
OPENSHIFT_API_URL=https://api.<cluster-domain>:443

# Required for `build`: external route of the internal image registry
# (`oc -n openshift-image-registry get route default-route -o jsonpath='{.spec.host}'`)
OPENSHIFT_REGISTRY=default-route-openshift-image-registry.apps.<cluster-domain>

# Required for `build`: branch of MLFLOW_GIT_REPO to build
MLFLOW_BRANCH=<branch-name>

# Optional
#NAMESPACE=mlflow
#KUBE_CONTEXT=<context>                 # defaults to your current context
#MLFLOW_GIT_REPO=https://github.com/mlflow/mlflow.git
#CONTAINER_ENGINE=podman                # or docker
